{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPUB Reference Studio",
  "version": "0.1.0",
  "identifier": "org.nexus.epub-reference-studio",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "EPUB Reference Studio", "width": 1380, "height": 900, "minWidth": 1000, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true, "targets": ["deb"], "icon": ["icons/128x128.png"],
    "category": "Office", "shortDescription": "Reference-assisted EPUB text analysis and reviewed repair"
  }
}
